<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:background="@color/blackTrans90"
    android:orientation="vertical"
    tools:context=".ui.HomeFragment">

    <!-- Placeholder layout for locking screen-->
    <FrameLayout
        android:id="@+id/lock"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:contentDescription="@string/lock_layout_description" />

    <!-- Home button for recents feature disabled -->
    <!-- Placeholder layout for showing recent apps
    <FrameLayout
        android:id="@+id/recents"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:contentDescription="@string/recents_layout_description" /> -->

    <!-- Clock and calendar-->
    <LinearLayout
        android:id="@+id/dateTimeLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginStart="64dp"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="64dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextClock
            android:id="@+id/clock"
            style="@style/TextDefault"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:format12Hour="hh:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:textSize="@dimen/time_size"
            tools:text="02:34" />

        <TextView
            android:id="@+id/date"
            style="@style/TextDefault"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/focus_pill_outline"
            android:format12Hour="EEE, dd MMM"
            android:format24Hour="EEE, dd MMM"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:letterSpacing="0.12"
            android:paddingStart="20dp"
            android:paddingEnd="22dp"
            android:paddingVertical="10dp"
            android:textAllCaps="true"
            android:textSize="@dimen/date_size"
            tools:text="Thu, 30 Dec" />

        <LinearLayout
            android:id="@+id/yearProgressLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <GridLayout
                android:id="@+id/yearProgressGraph"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:columnCount="18"
                android:rowCount="3" />

            <TextView
                android:id="@+id/yearProgressLabel"
                style="@style/TextSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:letterSpacing="0.16"
                android:textAllCaps="true"
                android:textColor="@color/blackInverseTrans50"
                android:textSize="9sp"
                tools:text="25/53 WEEKS" />
        </LinearLayout>
    </LinearLayout>

    <!-- Screen time-->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvScreenTime"
        style="@style/TextSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginHorizontal="64dp"
        android:layout_marginTop="72dp"
        android:background="@drawable/focus_pill_outline"
        android:fontFamily="monospace"
        android:gravity="center"
        android:letterSpacing="0.08"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:textSize="@dimen/date_size"
        android:visibility="gone"
        tools:text="2h 11m"
        tools:visibility="visible" />

    <!-- Home apps-->
    <LinearLayout
        android:id="@+id/homeAppsLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="64dp"
        android:layout_marginEnd="64dp"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            style="@style/FocusHomeShortcutRow">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/homeApp1"
                style="@style/FocusHomeShortcut"
                android:tag="@string/tag_1"
                android:visibility="gone"
                tools:src="@mipmap/ic_launcher"
                tools:visibility="visible" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/homeApp2"
                style="@style/FocusHomeShortcut"
                android:tag="@string/tag_2"
                android:visibility="gone"
                tools:src="@mipmap/ic_launcher"
                tools:visibility="visible" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/homeApp3"
                style="@style/FocusHomeShortcut"
                android:tag="@string/tag_3"
                android:visibility="gone"
                tools:src="@mipmap/ic_launcher"
                tools:visibility="visible" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/homeApp4"
                style="@style/FocusHomeShortcut"
                android:tag="@string/tag_4"
                android:visibility="gone"
                tools:src="@mipmap/ic_launcher"
                tools:visibility="visible" />
        </LinearLayout>

        <LinearLayout
            style="@style/FocusHomeShortcutRow">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/homeApp5"
                style="@style/FocusHomeShortcut"
                android:tag="@string/tag_5"
                android:visibility="gone"
                tools:src="@mipmap/ic_launcher"
                tools:visibility="visible" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/homeApp6"
                style="@style/FocusHomeShortcut"
                android:tag="@string/tag_6"
                android:visibility="gone"
                tools:src="@mipmap/ic_launcher"
                tools:visibility="visible" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/homeApp7"
                style="@style/FocusHomeShortcut"
                android:tag="@string/tag_7"
                android:visibility="gone"
                tools:src="@mipmap/ic_launcher"
                tools:visibility="visible" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/homeApp8"
                style="@style/FocusHomeShortcut"
                android:tag="@string/tag_8"
                android:visibility="gone"
                tools:src="@mipmap/ic_launcher"
                tools:visibility="visible" />
        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/firstRunTips"
        style="@style/TextSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="56dp"
        android:fontFamily="monospace"
        android:letterSpacing="0.08"
        android:text="@string/swipe_up_for_apps" />

    <!-- Set default launcher -->
    <TextView
        android:id="@+id/setDefaultLauncher"
        style="@style/TextMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="56dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/set_as_default_launcher_u"
        android:visibility="gone" />
</FrameLayout>
